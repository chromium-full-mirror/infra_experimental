#!/usr/bin/env lucicfg
# Copyright 2021 The Chromium Authors. All rights reserved.
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.

# Use LUCI Scheduler BBv2 names and add Scheduler realms configs.
lucicfg.enable_experiment("crbug.com/1182002")

luci.project(
    name = "infra-experimental",
    dev = True,
    change_verifier = "luci-change-verifier-dev.appspot.com",
    buildbucket = "cr-buildbucket-dev.appspot.com",
    logdog = "luci-logdog-dev.appspot.com",
    milo = "luci-milo-dev.appspot.com",
    notify = "luci-notify-dev.appspot.com",
    scheduler = "luci-scheduler-dev.appspot.com",
    swarming = "chromium-swarm-dev.appspot.com",
    acls = [
        acl.entry(
            roles = [
                acl.BUILDBUCKET_READER,
                acl.LOGDOG_READER,
                acl.PROJECT_CONFIGS_READER,
                acl.SCHEDULER_READER,
            ],
            groups = "all",
        ),
        acl.entry(
            roles = acl.LOGDOG_WRITER,
            groups = "luci-logdog-chromium-dev-writers",
        ),
        acl.entry(
            acl.CQ_COMMITTER,
            groups = "project-infra-tryjob-access",
        ),
        acl.entry(
            roles = acl.CQ_DRY_RUNNER,
            groups = "project-infra-tryjob-access",
        ),
    ],
)

luci.realm(
    name = "test",
    bindings = [
        luci.binding(
            roles = "role/luci.realmServiceAccount",
            users = "adhoc-testing@luci-token-server-dev.iam.gserviceaccount.com",
        ),
        luci.binding(
            roles = "role/luci.serviceAccountTokenCreator",
            groups = "mdb/chrome-troopers",
        ),
    ],
)

luci.logdog(gs_bucket = "chromium-luci-logdog")

# This hack is needed because we actually still use prod LUCI Config for this
# project and it looks at `realms.cfg` (not `realms-dev.cfg` which we generate
# for all other -dev services).
lucicfg.emit(
    dest = "realms.cfg",
    data = """
# Auto-generated by lucicfg.
# Do not modify manually.
#
# For the schema of this file, see RealmsCfg message:
#   https://luci-config.appspot.com/schemas/projects:realms.cfg

realms {
  name: "@root"
  bindings {
    role: "role/configs.reader"
    principals: "group:all"
  }
}
""".lstrip(),
)

# This should equate to a no-op CQ, so that CLs can at least be submitted.
luci.cq_group(
    name = "infra_experimental",
    watch = cq.refset(
        repo = "https://chromium.googlesource.com/infra/experimental",
        refs = [r"refs/heads/main"],
    ),
)
