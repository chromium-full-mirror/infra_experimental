{
  "manifest_version": 2,

  "name": "V8 code coverage",
  "description": "This extension shows code coverage data for v8 patches on Rietveld.",
  "version": "1.0",

  "permissions": [
    "tabs",
    "*://codereview.chromium.org/*",
    "*://storage.googleapis.com/chromium-v8/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://codereview.chromium.org/*/diff*"
      ],
      "js": [
        "scripts/diff_idle.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}